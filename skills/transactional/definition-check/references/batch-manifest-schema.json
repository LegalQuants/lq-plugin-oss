{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalquants.com/schemas/definition-check-batch-v1.json",
  "title": "Definition Check batch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "jobs"],
  "properties": {
    "schema_version": {
      "const": "definition-check-batch-v1"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "output_dir"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 1 },
          "output_dir": { "type": "string", "minLength": 1 },
          "work_dir": { "type": "string", "minLength": 1 },
          "agent_bundle": { "type": "string", "minLength": 1 },
          "common_terms": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "include_internal_traces": { "type": "boolean" },
          "qa_annotated_document": { "type": "boolean" },
          "debug_telemetry": { "type": "boolean" }
        }
      }
    }
  }
}
