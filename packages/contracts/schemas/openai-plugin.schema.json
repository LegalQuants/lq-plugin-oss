{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalquants.com/schemas/openai-plugin.schema.json",
  "title": "OpenAI Codex Plugin Manifest",
  "description": "Vendored shape of .codex-plugin/plugin.json from OpenAI's published plugin field guide. OpenAI does not publish a JSON Schema; pin updates deliberately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "skills"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "homepage": { "type": "string" },
    "repository": { "type": "string" },
    "license": { "type": "string" },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skills": {
      "type": "string",
      "const": "./skills/"
    },
    "hooks": {
      "type": "string",
      "pattern": "^\\./"
    },
    "mcpServers": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\./"
        },
        {
          "type": "object"
        }
      ]
    },
    "apps": {
      "type": "string",
      "pattern": "^\\./"
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logo", "composerIcon"],
      "properties": {
        "displayName": { "type": "string" },
        "shortDescription": { "type": "string" },
        "longDescription": { "type": "string" },
        "developerName": { "type": "string" },
        "category": { "type": "string" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "websiteURL": { "type": "string" },
        "privacyPolicyURL": { "type": "string" },
        "termsOfServiceURL": { "type": "string" },
        "defaultPrompt": {
          "type": "array",
          "items": { "type": "string" }
        },
        "brandColor": { "type": "string" },
        "composerIcon": { "type": "string" },
        "logo": { "type": "string" },
        "logoDark": { "type": "string" },
        "screenshots": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
