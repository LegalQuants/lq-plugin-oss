{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalquants.example/schemas/definition-check-matter-view-1.0.0.json",
  "title": "Definition Check Bounded Matter View",
  "type": "object",
  "required": ["package_schema", "view_type", "authority", "matter_id", "document_id", "version_id", "snapshot_sha256", "selected_document_version_ids", "missing_selected_companions", "components"],
  "properties": {
    "package_schema": { "const": "matter-view-v1" },
    "view_type": { "enum": ["defined_term_registry", "usage_index", "findings", "lawyer_report", "agent_review", "developer_audit", "version_comparison", "companion_review"] },
    "authority": { "const": "canonical_read_only" },
    "matter_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "version_id": { "type": "string", "minLength": 1 },
    "snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selected_document_version_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "missing_selected_companions": { "type": "array", "items": { "type": "string" } },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "document_id", "version_id", "records"],
        "properties": {
          "role": { "type": "string" },
          "document_id": { "type": ["string", "null"] },
          "version_id": { "type": ["string", "null"] },
          "records": {}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
